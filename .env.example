# ═══════════════════════════════════════════════════════════════════════════════
# FlowVest AI — Environment Variables Template (v2.0)
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control! It is gitignored.
# Required for: Docker Compose, local development, production deployment
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application Settings ───────────────────────────────────────────────────────
APP_VERSION=2.0.0
APP_NAME=FlowVest AI
APP_URL=http://localhost:3000
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://flowvest:flowvest123@postgres:5432/flowvest

# Connection pool settings (tune based on expected load)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Redis (Celery Broker + Cache) ──────────────────────────────────────────────
# Format: redis://HOST:PORT/DB_NUMBER
REDIS_URL=redis://redis:6379/0

# ── Celery Configuration ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_SOFT_TIME_LIMIT=300        # Warn after 5 minutes
CELERY_TASK_TIME_LIMIT=360             # Hard kill after 6 minutes

# ── Firebase Authentication ────────────────────────────────────────────────────
# Get from Firebase Console: https://console.firebase.google.com
FIREBASE_PROJECT_ID=your-firebase-project-id

# Option 1: Path to service account JSON file (recommended for production)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json

# Option 2: Set to "true" ONLY for local development (NEVER in production!)
# This bypasses JWT verification and trusts the x-demo-user header
AUTH_DISABLED=false

# ── OpenRouter (LLM Provider) ──────────────────────────────────────────────────
# Get API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Primary LLM model (DeepSeek offers best price/performance)
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Fallback model (used if primary fails or rate-limited)
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# LLM generation settings
LLM_MAX_TOKENS_ANALYSIS=220            # Market analysis output length
LLM_MAX_TOKENS_ADVISOR=280             # Investor memo output length
LLM_TEMPERATURE_ANALYSIS=0.4           # Lower = more deterministic
LLM_TEMPERATURE_ADVISOR=0.45           # Slightly higher for creative writing

# LLM prompt cache (seconds) — reduces API calls for identical prompts
LLM_CACHE_TTL=600                      # 10 minutes

# ── Market Data Providers ──────────────────────────────────────────────────────
# Alpha Vantage (Primary) — Get free key: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests/day, 5 requests/minute
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Financial Modeling Prep (Secondary) — Get free key: https://financialmodelingprep.com/developer/docs/
# Free tier: 250 requests/day
FMP_API_KEY=your-fmp-api-key

# Market data cache TTL (seconds) — reduces API calls for repeated requests
MARKET_CACHE_TTL=300                   # 5 minutes

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10               # Per-user limit on POST endpoints
RATE_LIMIT_GLOBAL_PER_MINUTE=200       # Global limit across entire API

# ── Versioning & Audit Trail ───────────────────────────────────────────────────
# Increment these when you change models, prompts, or allocation rules
MODEL_VERSION=v2
PROMPT_VERSION=v1
ALLOCATION_VERSION=v1

# ── Logging & Observability ────────────────────────────────────────────────────
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json                        # json or text (json recommended for production)

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx  # Optional: if using Clerk instead of Firebase

# ═══════════════════════════════════════════════════════════════════════════════
# Quick Start Checklist:
#   1. Copy this file: cp .env.example .env
#   2. Get OPENROUTER_API_KEY from https://openrouter.ai/keys
#   3. Get ALPHA_VANTAGE_API_KEY from https://www.alphavantage.co/support/#api-key
#   4. (Optional) Get FMP_API_KEY from https://financialmodelingprep.com/developer/docs/
#   5. (Optional) Set up Firebase project and add GOOGLE_APPLICATION_CREDENTIALS
#   6. For local dev only: set AUTH_DISABLED=true (NEVER in production!)
#   7. Run: docker-compose up --build
# ═══════════════════════════════════════════════════════════════════════════════
